# ─────────────────────────────────────────────────────────────────────────────
# chatbot-mairie-mezieres — Variables d'environnement
# Copiez ce fichier en .env et remplissez chaque valeur.
# Ne committez JAMAIS le fichier .env — il est dans .gitignore.
# ─────────────────────────────────────────────────────────────────────────────


# ── Serveur ──────────────────────────────────────────────────────────────────

PORT=3000

# Mot de passe de l'interface admin (GET /admin)
ADMIN_PASSWORD=changez-moi-en-production


# ── IA — Anthropic (Claude) ───────────────────────────────────────────────────
# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── IA — Mistral (optionnel, fallback ou chatbot alternatif) ─────────────────
# Clé API Mistral — https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_URL=https://api.mistral.ai/v1/chat/completions


# ── Redis / Upstash (cache, souscriptions push) ──────────────────────────────
# Créer une base sur https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://votre-base.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pour les stats via API REST Upstash (optionnel)
UPSTASH_EMAIL=votre@email.com
UPSTASH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UPSTASH_REDIS_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Base CIBLE pour la sauvegarde / migration (2e compte Upstash, ex. mairie).
# Renseigner pour activer la route /cron/backup (réplication mat:* → cible).
TARGET_UPSTASH_REDIS_REST_URL=https://votre-base-cible.upstash.io
TARGET_UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel : préfixes de clés à ne PAS répliquer (séparés par des virgules)
# REPLICATE_EXCLUDE=mat:mel:count:,mat:mel:ipcount:,mat:notify:token:


# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxA
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Météo — Open-Meteo (coordonnées de la commune) ───────────────────────────
# Open-Meteo est gratuit et open-source — https://open-meteo.com/
OPEN_METEO_LAT=47.822
OPEN_METEO_LON=1.808
OPEN_METEO_TZ=Europe/Paris


# ── Météo — Météo-France Vigilance (optionnel) ───────────────────────────────
# URL du flux vigilance département — https://portail-api.meteofrance.fr/
METEOFRANCE_VIGILANCE_URL=https://public-api.meteofrance.fr/public/DPVigilance/v1/cartevigilance/encours
# Token API Météo-France (si l'endpoint est authentifié)
METEOFRANCE_API_TOKEN=

# Publier automatiquement sur Facebook lors d'une alerte météo
AUTO_POST_WEATHER_ALERTS=false
# Niveau minimum de vigilance pour la publication Facebook (1=vert … 4=rouge)
AUTO_POST_MIN_LEVEL=3
# Niveau minimum pour envoyer une notification push aux abonnés
AUTO_PUSH_WEATHER_MIN_LEVEL=2
# Intervalle de vérification météo en ms (défaut : 15 min)
WEATHER_CHECK_INTERVAL_MS=900000

# ── Sécheresse / Restrictions VigiEau (séparé de la vigilance météo) ──────────
# Publier automatiquement une actu + push + Facebook quand le niveau sécheresse
# atteint « alerte » (2) ou plus. La vigilance (1) reste visible dans l'app mais
# ne déclenche aucune notification.
AUTO_POST_DROUGHT_ALERTS=false
# Code INSEE de la commune surveillée sur api.vigieau.gouv.fr (défaut : Mézières-lez-Cléry)
# 45204 = Mézières-lez-Cléry (45203 = Meung-sur-Loire)
VIGIEAU_COMMUNE_INSEE=45204
# Coordonnées du point de référence (bourg) pour la requête VigiEau par géométrie —
# même chemin que vigieau.gouv.fr pour une adresse. Défaut : OPEN_METEO_LAT/LON.
# L'API est interrogée par coordonnées ET par commune, niveau le plus grave retenu (ADR-0009).
VIGIEAU_LAT=47.822
VIGIEAU_LON=1.808
# Intervalle de vérification sécheresse en ms (défaut : 6 h — évolution lente)
DROUGHT_CHECK_INTERVAL_MS=21600000


# ── Facebook / Meta Graph API ────────────────────────────────────────────────
# Token d'accès longue durée de la Page Facebook officielle
PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Identifiant numérique de la Page Facebook
FACEBOOK_PAGE_ID=123456789012345
# Secret de l'app Meta (pour valider les webhooks)
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Token de vérification du webhook Facebook (valeur libre, choisie par vous)
VERIFY_TOKEN=mon-token-de-verification-webhook


# ── Google Calendar (agenda public) ─────────────────────────────────────────
# URL iCal publique du calendrier Google
GOOGLE_CALENDAR_ICAL=https://calendar.google.com/calendar/ical/xxxxxxxxxx%40group.calendar.google.com/public/basic.ics
# Identifiant du calendrier Google (pour l'API)
GOOGLE_CALENDAR_ID=xxxxxxxxxx@group.calendar.google.com
# Compte de service Google (JSON brut) — pour écriture sur le calendrier
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# Variante : le même JSON encodé en base64 (prend le dessus sur GOOGLE_SERVICE_ACCOUNT)
GOOGLE_SERVICE_ACCOUNT_B=


# ── Cloudinary (hébergement photos signalements) ─────────────────────────────
# Créer un compte sur https://cloudinary.com/
CLOUDINARY_NAME=votre-cloud-name
CLOUDINARY_KEY=123456789012345
CLOUDINARY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Trello (gestion des signalements et bugs) ────────────────────────────────
# Clé et token API Trello — https://trello.com/app-key
TRELLO_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRELLO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Identifiants des listes cibles dans le board Trello
TRELLO_LIST_ID_BUG=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRELLO_LIST_ID_SIG=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRELLO_LIST_ID_DEMANDE=xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── OpenAgenda (agenda alternatif) ───────────────────────────────────────────
# Clé API OpenAgenda — https://openagenda.com/
OPENAGENDA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Email — Resend (stats quotidiennes) ──────────────────────────────────────
# Clé API Resend — https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Expéditeur des emails (doit être un domaine vérifié dans Resend)
RESEND_FROM=noreply@votre-domaine.fr
# Destinataire des rapports quotidiens de statistiques
DAILY_STATS_EMAIL=votre@email.com


# ── Cron jobs sécurisés ───────────────────────────────────────────────────────
# Secret passé en header X-Cron-Secret pour les routes cron internes
# Routes : /cron/stats, /cron/meteo, /cron/backup (sauvegarde Upstash → cible)
#   ex. https://<chatbot>/cron/backup?key=CRON_SECRET
CRON_SECRET=chaine-aleatoire-longue-et-secrete


# ── Kit de réplication « Partager » ───────────────────────────────────────────
# Communes à NE PAS enregistrer dans les profils collectés (essais du porteur de
# projet), séparées par des virgules. S'ajoutent aux essais déjà écartés par
# défaut : « ville test », « cancale », et tout nom contenant le mot test /
# essai / demo. Voir GUIDE-ADMIN.md §6bis.
PARTAGER_IGNORE_COMMUNES=


# ── Debug ─────────────────────────────────────────────────────────────────────
# Mettre à "1" pour activer les logs verbeux (ne pas activer en production)
MAT_DEBUG=0
